    {
      "name": "02 - Policies",
      "item": [
        {
          "name": "Create Motor Policy",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is below 2000 ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Policy ID is generated\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"id\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Registration number is correct\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.regNumber).to.eql(pm.environment.get(\"reg_number\"));\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Policy status is active\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.status).to.eql(\"active\");\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "pm.environment.set(\"policy_id\", jsonData.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueNumber = Date.now();\r",
                  "const regNumber = \"QA-\" + uniqueNumber;\r",
                  "\r",
                  "pm.environment.set(\"reg_number\", regNumber);\r",
                  "\r",
                  "console.log(\"Generated registration number:\", regNumber);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"regNumber\": \"{{reg_number}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/mtpl/v1/policies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mtpl",
                "v1",
                "policies"
              ]
            }
          },
          "response": []
        },
