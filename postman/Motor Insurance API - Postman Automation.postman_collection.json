  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Get Demo Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is below 2000 ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Client credentials are returned\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    pm.expect(jsonData).to.have.property(\"client_id\");\r",
                  "    pm.expect(jsonData).to.have.property(\"client_secret\");\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.environment.set(\"client_id\", jsonData.client_id);\r",
                  "pm.environment.set(\"client_secret\", jsonData.client_secret);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "packages": {},
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/mtpl/v1/demo-clients",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mtpl",
                "v1",
                "demo-clients"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is below 2000 ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Access token is returned\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"access_token\");\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
